#!/usr/bin/env fish
set -x MISE_DATA_DIR "$HOME/.mysh/mise"

if test -z "$TF_ASSUME_WRAPPED"
    set profile ""
    for arg in $argv
        switch $arg
            case '*prod*.tfvars'
                set profile "DeployerExt@tvlk-fpr-prod"
                break
            case '*stg*.tfvars'
                set profile "DeployerExt@tvlk-fpr-stg"
                break
        end
    end

    if test -z "$profile"
        switch $PWD
            case '*/production/*'
                set profile "DeployerExt@tvlk-fpr-prod"
            case '*/staging/*'
                set profile "DeployerExt@tvlk-fpr-stg"
        end
    end

    if test -n "$profile"
        set -x TF_ASSUME_WRAPPED 1
        exec assume "$profile" -x --exec "terraform $argv"
    end
end

exec mise x terraform@"$(fish -c tf-version-name)" -- terraform $argv
