#!/usr/bin/env fish
set -x MISE_DATA_DIR "$HOME/.mysh/mise"

set environment ""
for arg in $argv
    switch $arg
        case '*prod*.tfvars'
            set environment prod
            break
        case '*stg*.tfvars'
            set environment stg
            break
    end
end

if test -z "$environment"
    switch $PWD
        case '*/production/*'
            set environment prod
        case '*/staging/*'
            set environment stg
    end
end

if not set -q TF_ASSUME_WRAPPED; and test -n "$environment"
    set -x TF_ASSUME_WRAPPED 1
    assume "DeployerExt@tvlk-fpr-$environment" -x --exec "terraform $argv"
    exit $status
end

set terraform_version (terraform-version-name)
set wrapper_directory (path dirname (status filename))
python3 -B "$wrapper_directory/lib/terraform_runner.py" "$terraform_version" "$environment" $argv
exit $status
