#!/usr/bin/env fish
# Wrapper features:
# - Choose stg or prod from a manual backend/variable filename first. If no filename
#   identifies an environment, use AWS_PROFILE, then the current folder, then stg.
# - Check files supplied through -var-file or -backend-config, using either =file
#   or a separate argument. A filename must end in .tfvars and contain prod or stg;
#   if several files match, the last matching file determines the environment.
#   Custom filenames that match neither environment still override the default file.
# - Read prod or stg from anywhere in AWS_PROFILE. If neither appears, use the
#   folder or default stg for environment selection, and keep that profile's credentials.
# - If AWS_PROFILE is empty, assume DeployerExt@tvlk-fpr-{environment}. If it is one
#   of these two standard profiles and a manual file selects the other environment,
#   assume the other standard profile. Keep any custom profile's credentials,
#   including when a manual file selects a different environment.
# - Missing backend or variable files required by the command cause an error
#   rather than silently using another file.
# - Recognize staging/stg and production/prod directories, including their
#   subdirectories. Detect the environment from the original working directory;
#   a leading -chdir changes where Terraform reads files, not the environment.
# - Set TF_ASSUME_WRAPPED before calling assume so the restarted wrapper does not
#   assume again. Auto-init and the requested command inherit the same credentials.
# - Read the Terraform version from terraform-version-name and run it through mise.
# - For explicit init and auto-init, use var-{environment}-backend.tfvars. An explicit
#   init with manual -backend-config options uses those options instead of this default.
# - For plan/apply, add var-{environment}.tfvars unless manual -var-file options were
#   supplied. Keep the supplied files, and let Terraform apply their values in order.
# - When applying a saved plan, do not add a var-file because the plan already
#   contains its variables. Any manual options are still passed to Terraform.
# - Before configuration commands other than init/get, run auto-init if the selected
#   backend settings differ from the cached settings, or local module overrides
#   exist and the installed module list is missing or outdated. If init fails, stop.
# - Auto-init uses -input=false and the selected environment's backend file when
#   available. It keeps a leading -chdir but does not copy other caller arguments.
# - Help requests and commands that do not use configuration pass directly to Terraform.
# - Cache Traveloka GitHub modules in local Git worktrees and temporarily point
#   Terraform at them. Follow nested local modules and expand sparse checkouts as needed.
# - Keep module refs pinned separately for each Terraform data directory, including
#   TF_DATA_DIR. Refresh them with init -upgrade or get -update, or by deleting their
#   ref cache. Refresh flags also read TF_CLI_ARGS, TF_CLI_ARGS_init, and
#   TF_CLI_ARGS_get; the last flag setting wins. Remove temporary module override
#   files after execution.
# - Module scanning supports literal sources, and backend comparison supports scalar
#   settings. For a backend file with non-scalar settings, run explicit init.
# - Run Python with -B so it does not create bytecode files or __pycache__ directories.
# - Role routing is opt-in with --override (consumed by the runner).
#   Rules live in lib/terraform_override_rules.py. Affected module packages are
#   copied per working directory; normal runs restore the original module sources.
# - Only --override runs need uv/python-hcl2; normal runs use Python directly.
# Checks: fish --no-execute terraform
# Checks: uv run --no-project --with 'python-hcl2>=8,<9' python -B -m unittest -v test_terraform.py test_terraform_roles.py
set -x MISE_DATA_DIR "$HOME/.mysh/mise"

set environment stg
set argument_environment ""
set expects_file 0
for arg in $argv
    set filename ""
    if test "$expects_file" = 1
        set filename "$arg"
        set expects_file 0
    end
    switch $arg
        case '-var-file' '-backend-config'
            set expects_file 1
        case '-var-file=*' '-backend-config=*'
            set filename (string split --max 1 '=' -- "$arg")[2]
    end
    switch "$filename"
        case '*prod*.tfvars'
            set argument_environment prod
        case '*stg*.tfvars'
            set argument_environment stg
    end
end

set profile_environment ""
switch "$AWS_PROFILE"
    case '*prod*'
        set profile_environment prod
    case '*stg*'
        set profile_environment stg
end

if test -n "$argument_environment"
    set environment "$argument_environment"
else if test -n "$profile_environment"
    set environment "$profile_environment"
else
    switch $PWD
        case '*/production' '*/production/*' '*/prod' '*/prod/*'
            set environment prod
        case '*/staging' '*/staging/*' '*/stg' '*/stg/*'
            set environment stg
    end
end

set target_profile "DeployerExt@tvlk-fpr-$environment"
set needs_assume 0
if test -z "$AWS_PROFILE"
    set needs_assume 1
else if contains -- "$AWS_PROFILE" 'DeployerExt@tvlk-fpr-stg' 'DeployerExt@tvlk-fpr-prod'; and test "$AWS_PROFILE" != "$target_profile"
    set needs_assume 1
end

if not set -q TF_ASSUME_WRAPPED; and test "$needs_assume" = 1
    set -x TF_ASSUME_WRAPPED 1
    set terraform_command (string join ' ' -- terraform (string escape -- $argv))
    assume "$target_profile" -x --exec "$terraform_command"
    exit $status
end

set terraform_version (terraform-version-name)
set wrapper_directory (path dirname (status filename))
if contains -- --override $argv
    uv run --no-project --with 'python-hcl2>=8,<9' python -B "$wrapper_directory/lib/terraform_runner.py" "$terraform_version" "$environment" $argv
else
    python3 -B "$wrapper_directory/lib/terraform_runner.py" "$terraform_version" "$environment" $argv
end
exit $status
