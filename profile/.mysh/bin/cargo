#!/usr/bin/env fish
set -x MISE_DATA_DIR "$HOME/.mysh/mise"
set mise_bin (command -v mise)
if test -x $HOME/.cargo/bin/cargo
    exec $mise_bin x rust@latest -- $HOME/.cargo/bin/cargo $argv
else
    set -x PATH (string match -v (status dirname) $PATH)
    exec $mise_bin x rust@latest -- cargo $argv
end
