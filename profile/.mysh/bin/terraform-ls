#!/usr/bin/env fish
set -x MISE_DATA_DIR "$HOME/.mysh/mise"
if contains -- serve $argv
    set -l wrapper_directory (path dirname (status filename))
    exec python3 -B "$wrapper_directory/lib/terraform_lsp.py" mise x terraform-ls@latest -- terraform-ls $argv
end
exec mise x terraform-ls@latest -- terraform-ls $argv
